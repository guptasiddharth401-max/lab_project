# Application
NODE_ENV=development
API_PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_saas

# Session
SESSION_SECRET=your-secure-secret-change-in-production

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_MINUTES=1
OTP_RATE_LIMIT_MAX_REQUESTS=3

# CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
